# Example environment template
# Copy this to .env.backend and replace values with your own secrets.

NODE_ENV=development
PORT=3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

RPC_URL=https://api.mainnet-beta.solana.com
WS_RPC_URL=wss://api.mainnet-beta.solana.com
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=
HELIUS_WEBHOOK_URL=
SOLANA_KEY_PATH=./keypair.json

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

WALLET_ISOLATION_STRICT=true
MAX_WALLETS=3
WALLET_AUTO_DISCOVERY=false

SYSTEM_MODE=shadow
TRADING_PAUSED=false
DRY_RUN=true
LIVE_TRADING=false

TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_IDS=

MAX_POSITION_USD=500
MAX_EXPOSURE_USD=5000
MAX_LEVERAGE=1
STOP_LOSS_PERCENT=5
TAKE_PROFIT_PERCENT=25
MAX_OPEN_POSITIONS=5

SEND_SIGNAL_ALERTS=true
SEND_TRADE_ALERTS=true
SEND_ERROR_ALERTS=true
SEND_HEALTH_ALERTS=true

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
