// ============================================================================
// VALIDATION
// ============================================================================

/**
 * Validate required environment variables
 */
export function validateConfig(): { valid: boolean; errors: string[] } {
  const errors: string[] = [];

  // Required
  if (!BLOCKCHAIN.RPC_URL) errors.push('RPC_URL not set');
  if (!DATABASE.SUPABASE_URL) errors.push('SUPABASE_URL not set');
  if (!DATABASE.SUPABASE_KEY) errors.push('SUPABASE_ANON_KEY not set');
  if (!TELEGRAM.TOKEN) errors.push('TELEGRAM_BOT_TOKEN not set');

  // Wallet isolation validation
  if (WALLET_CONFIG.ISOLATION_STRICT && WALLET_CONFIG.MAX_WALLETS < 1) {
    errors.push('MAX_WALLETS must be at least 1');
  }

  return {
    valid: errors.length === 0,
    errors,
  };
}

